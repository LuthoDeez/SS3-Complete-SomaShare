@page "/"

<div class="hero-section py-5 text-white text-center"
     style="background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%); min-height: 60vh; display:flex; align-items:center;">
    <div class="container">
        <div class="mb-3" style="font-size:4rem;">📚</div>
        <h1 class="display-4 fw-bold mb-3">Welcome to SomaShare</h1>
        <p class="lead mb-2">
            Connecting students who need textbooks with those selling them.
        </p>
        <p class="mb-4 opacity-75">
            Affordable. Trusted. Community-driven. <em>Inspired by Africa.</em>
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a href="/account/register" class="btn btn-light btn-lg fw-semibold px-4">
                🎓 Get Started
            </a>
            <a href="/account/login" class="btn btn-outline-light btn-lg px-4">
                🔑 Login
            </a>
        </div>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4 text-center">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm p-4">
                <div class="fs-1 mb-3">📖</div>
                <h5 class="fw-bold">Sell Your Textbooks</h5>
                <p class="text-muted">List your used textbooks and connect with buyers on your campus.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm p-4">
                <div class="fs-1 mb-3">🔍</div>
                <h5 class="fw-bold">Find What You Need</h5>
                <p class="text-muted">Browse listings, post a wanted ad, and make offers at prices that work for you.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm p-4">
                <div class="fs-1 mb-3">⭐</div>
                <h5 class="fw-bold">Build Community Trust</h5>
                <p class="text-muted">Our Trust Score system ensures safe meetups and honest transactions across campuses.</p>
            </div>
        </div>
    </div>

    <div class="text-center mt-5">
        <p class="text-muted">
            Inspired by
            <strong>Rebooked</strong>, <strong>Bookbay</strong>, and <strong>Qataloog</strong> —
            African ed-tech pioneers making education affordable.
        </p>
    </div>
</div>
