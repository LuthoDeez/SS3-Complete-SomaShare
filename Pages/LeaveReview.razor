@page "/reviews/leave/{revieweeId}"
@attribute [Authorize]
@inject ReviewService ReviewService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<div class="container mt-4" style="max-width: 500px;">
    <h2 class="fw-bold mb-4">⭐ Leave a Review</h2>

    @if (reviewee == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else if (submitted)
    {
        <div class="text-center py-5">
            <div style="font-size:3rem;">🌟</div>
            <h5 class="fw-bold mt-2">Review submitted!</h5>
            <p class="text-muted">
                @reviewee.FullName's Trust Score has been updated.
            </p>
            <a href="/dashboard" class="btn btn-primary">Back to Dashboard</a>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary text-white d-flex align-items-center
                            justify-content-center flex-shrink-0"
                     style="width:50px;height:50px;font-size:1.4rem;">
                    @(reviewee.FullName?.FirstOrDefault().ToString().ToUpper() ?? "?")
                </div>
                <div>
                    <h6 class="fw-bold mb-0">@reviewee.FullName</h6>
                    <small class="text-muted">@reviewee.Campus</small>
                    <span class="badge bg-warning text-dark ms-2">
                        ⭐ Trust @reviewee.TrustScore
                    </span>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">❌ @errorMessage</div>
        }

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <EditForm Model="model" OnValidSubmit="SubmitReview">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Rating</label>
                        <div class="d-flex gap-2">
                            @for (int s = 1; s <= 5; s++)
                            {
                                int star = s;
                                <button type="button"
                                        class="btn @(model.Rating >= star ? "btn-warning" : "btn-outline-secondary") btn-sm"
                                        style="font-size:1.4rem; width:46px;"
                                        @onclick="() => model.Rating = star">
                                    ⭐
                                </button>
                            }
                        </div>
                        @if (model.Rating == 0)
                        {
                            <div class="text-danger small mt-1">Please select a rating.</div>
                        }
                        <div class="form-text mt-1">
                            @RatingLabel(model.Rating)
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Comment</label>
                        <InputTextArea class="form-control" @bind-Value="model.Comment"
                                       rows="4"
                                       placeholder="How was your experience with this seller?" />
                        <ValidationMessage For="@(() => model.Comment)" class="text-danger small" />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning fw-semibold flex-grow-1"
                                disabled="@(isLoading || model.Rating == 0)">
                            @(isLoading ? "Submitting..." : "🌟 Submit Review")
                        </button>
                        <a href="/dashboard" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string RevieweeId { get; set; } = "";

    private ApplicationUser? reviewee;
    private bool submitted = false;
    private bool isLoading = false;
    private string errorMessage = "";

    private ReviewModel model = new();

    protected override async Task OnInitializedAsync()
    {
        reviewee = await UserManager.FindByIdAsync(RevieweeId);
        if (reviewee == null)
            NavigationManager.NavigateTo("/dashboard");
    }

    private async Task SubmitReview()
    {
        if (model.Rating == 0)
        {
            errorMessage = "Please select a star rating.";
            return;
        }

        errorMessage = "";
        isLoading = true;

        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var reviewerId = auth.User.FindFirst(
            System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (reviewerId == RevieweeId)
        {
            errorMessage = "You cannot review yourself.";
            isLoading = false;
            return;
        }

        try
        {
            var review = new Review
            {
                ReviewerId = reviewerId!,
                RevieweeId = RevieweeId,
                Rating = model.Rating,
                Comment = model.Comment
            };

            await ReviewService.CreateReviewAsync(review);
            // Refresh reviewee to show updated trust score
            reviewee = await UserManager.FindByIdAsync(RevieweeId);
            submitted = true;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }

        isLoading = false;
    }

    private string RatingLabel(int r) => r switch
    {
        1 => "😞 Poor experience",
        2 => "😐 Below average",
        3 => "🙂 Average",
        4 => "😊 Good experience",
        5 => "🌟 Excellent!",
        _ => "Click a star to rate"
    };

    public class ReviewModel
    {
        public int Rating { get; set; } = 0;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please write a comment.")]
        [System.ComponentModel.DataAnnotations.MinLength(10,
            ErrorMessage = "Comment must be at least 10 characters.")]
        public string Comment { get; set; } = "";
    }
}
