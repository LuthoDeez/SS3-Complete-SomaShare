@page "/wantedads"
@attribute [Authorize]
@inject WantedAdService WantedAdService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Wanted Ads - SomaShare</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h2 class="fw-bold mb-0">🔍 Wanted Ads</h2>
        <a href="/wantedads/create" class="btn btn-primary fw-semibold">➕ Post Wanted Ad</a>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-success alert-dismissible">
            @statusMessage
            <button type="button" class="btn-close"
                    @onclick="() => statusMessage = string.Empty"></button>
        </div>
    }

    @if (ads == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Loading ads...</p>
        </div>
    }
    else if (!ads.Any())
    {
        <div class="text-center py-5">
            <div style="font-size:3rem;">📭</div>
            <h5 class="text-muted mt-2">No wanted ads yet.</h5>
            <p class="text-muted">Looking for a textbook? <a href="/wantedads/create">Post a wanted ad</a>.</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var ad in ads)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-info text-dark">Wanted</span>
                                <span class="fw-bold text-success">Max: R @ad.MaxPrice.ToString("N0")</span>
                            </div>
                            <h5 class="card-title fw-bold mb-1">@ad.Title</h5>
                            @if (!string.IsNullOrEmpty(ad.CourseCode))
                            {
                                <p class="text-muted small mb-1">📖 Course: <strong>@ad.CourseCode</strong></p>
                            }
                            <p class="text-muted small mb-1">👤 @(ad.User?.FullName ?? "Anonymous")</p>
                            <p class="text-muted small mb-3">📅 @ad.DatePosted.ToString("dd MMM yyyy")</p>

                            @if (ad.UserId == currentUserId)
                            {
                                <div class="mt-auto d-flex gap-2">
                                    <a href="/wantedads/edit/@ad.Id"
                                       class="btn btn-sm btn-outline-secondary flex-grow-1">✏️ Edit</a>
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => ConfirmDelete(ad.Id)">🗑️</button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (showDeleteConfirm)
    {
        <div class="modal-backdrop" style="position:fixed;top:0;left:0;width:100%;height:100%;
             background:rgba(0,0,0,0.5);z-index:1040;"></div>
        <div class="modal d-block" style="z-index:1050;">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow">
                    <div class="modal-header">
                        <h5 class="modal-title">🗑️ Delete Wanted Ad</h5>
                    </div>
                    <div class="modal-body">Are you sure you want to delete this wanted ad?</div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary"
                                @onclick="() => showDeleteConfirm = false">Cancel</button>
                        <button class="btn btn-danger" @onclick="DeleteAd">Yes, Delete</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<WantedAd>? ads;
    private string currentUserId = "";
    private string statusMessage = "";
    private bool showDeleteConfirm = false;
    private int deleteTargetId;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = auth.User.FindFirst(
            System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        ads = await WantedAdService.GetAllWantedAdsAsync();
    }

    private void ConfirmDelete(int id) { deleteTargetId = id; showDeleteConfirm = true; }

    private async Task DeleteAd()
    {
        try
        {
            await WantedAdService.DeleteWantedAdAsync(deleteTargetId, currentUserId);
            statusMessage = "Wanted ad deleted.";
            ads = await WantedAdService.GetAllWantedAdsAsync();
        }
        catch (Exception ex) { statusMessage = $"Error: {ex.Message}"; }
        showDeleteConfirm = false;
    }
}
