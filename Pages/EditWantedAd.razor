@page "/wantedads/edit/{id:int}"
@attribute [Authorize]
@inject WantedAdService WantedAdService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<div class="container mt-4" style="max-width: 550px;">
    <h2 class="fw-bold mb-4">✏️ Edit Wanted Ad</h2>

    @if (notFound)
    {
        <div class="alert alert-warning">Ad not found.</div>
        <a href="/wantedads" class="btn btn-outline-primary">← Back</a>
    }
    else if (model == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">❌ @errorMessage</div>
        }

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <EditForm Model="model" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Textbook Title *</label>
                        <InputText class="form-control" @bind-Value="model.Title" />
                        <ValidationMessage For="@(() => model.Title)" class="text-danger small" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Course Code</label>
                        <InputText class="form-control" @bind-Value="model.CourseCode" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Maximum Price (R) *</label>
                        <div class="input-group">
                            <span class="input-group-text">R</span>
                            <InputNumber class="form-control" @bind-Value="model.MaxPrice" />
                        </div>
                        <ValidationMessage For="@(() => model.MaxPrice)" class="text-danger small" />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary fw-semibold flex-grow-1"
                                disabled="@isLoading">
                            @(isLoading ? "Saving..." : "💾 Save Changes")
                        </button>
                        <a href="/wantedads" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private WantedAd? model;
    private string errorMessage = "";
    private bool isLoading = false;
    private bool notFound = false;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = auth.User.FindFirst(
            System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        model = await WantedAdService.GetWantedAdByIdAsync(Id);
        if (model == null) { notFound = true; return; }

        if (model.UserId != userId)
            NavigationManager.NavigateTo("/wantedads");
    }

    private async Task HandleSubmit()
    {
        errorMessage = "";
        isLoading = true;
        try
        {
            await WantedAdService.UpdateWantedAdAsync(model!);
            NavigationManager.NavigateTo("/wantedads");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        isLoading = false;
    }
}
