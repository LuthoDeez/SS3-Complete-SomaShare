@page "/textbooks"
@attribute [Authorize]
@inject TextbookService TextbookService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h2 class="fw-bold mb-0">📚 Textbook Listings</h2>
        <AuthorizeView Roles="Seller,Admin">
            <Authorized>
                <a href="/textbooks/create" class="btn btn-primary fw-semibold">
                    ➕ Add Listing
                </a>
            </Authorized>
        </AuthorizeView>
    </div>

    @* ── Search & Filter Bar ─────────────────────────── *@
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Search</label>
                    <input class="form-control" placeholder="Title, author, ISBN..."
                           value="@searchTerm"
                           @oninput="OnSearchInput" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">Condition</label>
                    <select class="form-select" value="@filterCondition"
                            @onchange="OnConditionChange">
                        <option value="">All</option>
                        <option>New</option>
                        <option>Good</option>
                        <option>Fair</option>
                        <option>Poor</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">Campus</label>
                    <select class="form-select" value="@filterCampus"
                            @onchange="OnCampusChange">
                        <option value="">All Campuses</option>
                        <option>Wits</option><option>UCT</option><option>UNISA</option>
                        <option>UP</option><option>Stellenbosch</option>
                        <option>DUT</option><option>UJ</option><option>UKZN</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">Max Price (R)</label>
                    <input type="number" class="form-control" placeholder="e.g. 500"
                           value="@maxPriceStr"
                           @oninput="OnMaxPriceInput" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">Sort By</label>
                    <select class="form-select" value="@sortBy"
                            @onchange="OnSortChange">
                        <option value="date">Newest First</option>
                        <option value="price_asc">Price ↑</option>
                        <option value="price_desc">Price ↓</option>
                    </select>
                </div>
                <div class="col-md-1">
                    <button class="btn btn-outline-secondary w-100" @onclick="ClearFilters">✕</button>
                </div>
            </div>
        </div>
    </div>

    @* ── Results ─────────────────────────────────────── *@
    @if (pagedBooks == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Loading listings...</p>
        </div>
    }
    else if (!pagedBooks.Any())
    {
        <div class="text-center py-5">
            <div style="font-size:3rem;">📭</div>
            <h5 class="text-muted mt-2">No textbooks found.</h5>
            <p class="text-muted">Try adjusting your filters or <a href="/textbooks/create">add a listing</a>.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var book in pagedBooks)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge @ConditionBadge(book.Condition)">@book.Condition</span>
                                <span class="fw-bold text-success fs-5">R @book.Price.ToString("N0")</span>
                            </div>
                            <h5 class="card-title fw-bold mb-1">@book.Title</h5>
                            <p class="text-muted small mb-1">✍️ @(book.Author ?? "Unknown Author")</p>
                            @if (!string.IsNullOrEmpty(book.ISBN))
                            {
                                <p class="text-muted small mb-1">🔖 ISBN: @book.ISBN</p>
                            }
                            <p class="text-muted small mb-1">📍 @(book.Campus ?? "Any Campus")</p>
                            <p class="text-muted small mb-3">
                                👤 @(book.Seller?.FullName ?? "Unknown")
                                <span class="badge bg-light text-dark ms-1">⭐ @(book.Seller?.TrustScore ?? 0)</span>
                            </p>
                            <div class="mt-auto d-flex gap-2 flex-wrap">
                                @if (book.IsAvailable)
                                {
                                    @if (book.SellerId != currentUserId)
                                    {
                                        <a href="/offers/make/@book.TextbookId"
                                           class="btn btn-primary btn-sm fw-semibold flex-grow-1">
                                            💰 Make Offer
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="/textbooks/edit/@book.TextbookId"
                                           class="btn btn-outline-secondary btn-sm">✏️ Edit</a>
                                        <button class="btn btn-outline-danger btn-sm"
                                                @onclick="() => ConfirmDelete(book.TextbookId)">
                                            🗑️ Delete
                                        </button>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-secondary py-2 px-3">Sold</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* ── Pagination ──────────────────────────────── *@
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => GoToPage(currentPage - 1)">‹ Prev</button>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    int pageNum = i;
                    <li class="page-item @(currentPage == pageNum ? "active" : "")">
                        <button class="page-link" @onclick="() => GoToPage(pageNum)">@pageNum</button>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="() => GoToPage(currentPage + 1)">Next ›</button>
                </li>
            </ul>
            <p class="text-center text-muted small">
                Showing @pagedBooks.Count of @filteredBooks.Count listings
            </p>
        </nav>
    }

    @* ── Delete Confirmation Modal ───────────────────── *@
    @if (showDeleteConfirm)
    {
        <div class="modal-backdrop" style="position:fixed;top:0;left:0;width:100%;height:100%;
             background:rgba(0,0,0,0.5);z-index:1040;"></div>
        <div class="modal d-block" style="z-index:1050;">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow">
                    <div class="modal-header">
                        <h5 class="modal-title">🗑️ Confirm Delete</h5>
                    </div>
                    <div class="modal-body">
                        Are you sure you want to delete this listing? This cannot be undone.
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="() => showDeleteConfirm = false">Cancel</button>
                        <button class="btn btn-danger" @onclick="DeleteBook">Yes, Delete</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<Textbook> allBooks = new();
    private List<Textbook> filteredBooks = new();
    private List<Textbook>? pagedBooks;

    private string searchTerm = "";
    private string filterCondition = "";
    private string filterCampus = "";
    private string maxPriceStr = "";
    private decimal? maxPrice;
    private string sortBy = "date";

    private int currentPage = 1;
    private int pageSize = 6;
    private int totalPages = 1;

    private string currentUserId = "";
    private bool showDeleteConfirm = false;
    private int deleteTargetId;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = auth.User.FindFirst(
            System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        allBooks = await TextbookService.GetAllTextbooksAsync();
        FilterBooks();
    }

    // Individual event handlers — avoids duplicate attribute errors
    private void OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        FilterBooks();
    }
    private void OnConditionChange(ChangeEventArgs e)
    {
        filterCondition = e.Value?.ToString() ?? "";
        FilterBooks();
    }
    private void OnCampusChange(ChangeEventArgs e)
    {
        filterCampus = e.Value?.ToString() ?? "";
        FilterBooks();
    }
    private void OnMaxPriceInput(ChangeEventArgs e)
    {
        maxPriceStr = e.Value?.ToString() ?? "";
        maxPrice = decimal.TryParse(maxPriceStr, out var p) ? p : (decimal?)null;
        FilterBooks();
    }
    private void OnSortChange(ChangeEventArgs e)
    {
        sortBy = e.Value?.ToString() ?? "date";
        FilterBooks();
    }

    private void FilterBooks()
    {
        var query = allBooks.AsQueryable();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var term = searchTerm.ToLower();
            query = query.Where(b =>
                (b.Title != null && b.Title.ToLower().Contains(term)) ||
                (b.Author != null && b.Author.ToLower().Contains(term)) ||
                (b.ISBN != null && b.ISBN.ToLower().Contains(term)));
        }
        if (!string.IsNullOrEmpty(filterCondition))
            query = query.Where(b => b.Condition == filterCondition);
        if (!string.IsNullOrEmpty(filterCampus))
            query = query.Where(b => b.Campus == filterCampus);
        if (maxPrice.HasValue)
            query = query.Where(b => b.Price <= maxPrice.Value);

        query = sortBy switch
        {
            "price_asc"  => query.OrderBy(b => b.Price),
            "price_desc" => query.OrderByDescending(b => b.Price),
            _            => query.OrderByDescending(b => b.DatePosted)
        };

        filteredBooks = query.ToList();
        totalPages = Math.Max(1, (int)Math.Ceiling((double)filteredBooks.Count / pageSize));
        currentPage = 1;
        ApplyPaging();
    }

    private void ApplyPaging()
    {
        pagedBooks = filteredBooks.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
    }

    private void GoToPage(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        ApplyPaging();
    }

    private void ClearFilters()
    {
        searchTerm = ""; filterCondition = ""; filterCampus = "";
        maxPriceStr = ""; maxPrice = null; sortBy = "date";
        FilterBooks();
    }

    private void ConfirmDelete(int id) { deleteTargetId = id; showDeleteConfirm = true; }

    private async Task DeleteBook()
    {
        await TextbookService.DeleteTextbookAsync(deleteTargetId, currentUserId);
        allBooks = await TextbookService.GetAllTextbooksAsync();
        showDeleteConfirm = false;
        FilterBooks();
    }

    private string ConditionBadge(string? c) => c switch
    {
        "New"  => "bg-success",
        "Good" => "bg-primary",
        "Fair" => "bg-warning text-dark",
        "Poor" => "bg-danger",
        _      => "bg-secondary"
    };
}
